{
  "version": 2,
  "builds": [
    {
      "src": "index.ts",
      "use": "@vercel/node",
      "config": {
        "runtime": "nodejs"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.ts"
    }
  ],
  "env": {
    "FRONTEND_URL": "https://schedule-sai.vercel.app",
    "BACKEND_URL": "https://schedule-backend-navy.vercel.app"
  }
}